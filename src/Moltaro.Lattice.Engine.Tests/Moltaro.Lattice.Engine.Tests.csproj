<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The tests of the engine database read and write through the public interfaces as the scenario
         tests do; like them, they do not thread the test cancellation token through every call. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Moltaro.Lattice.Engine\Moltaro.Lattice.Engine.csproj" />
    <!-- The measurement program, for the tests of its reference fixture. -->
    <ProjectReference Include="..\Moltaro.Lattice.Measurements\Moltaro.Lattice.Measurements.csproj" />
    <ProjectReference Include="..\Moltaro.Lattice.TestSupport\Moltaro.Lattice.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests of Epic 1, sprint S13 that name what its implementation adds to the engine:
         EngineCounters.TextEntries and TextTableBytes, and EngineDatabase.TextReferences. They do not
         compile before it, and are skipped with the reason of the sprint as well. The implementer of S13
         removes this item group. -->
    <Compile Remove="Engine\Text\EntryCounts.cs" />
    <Compile Remove="Engine\Text\SharingTests.cs" />
    <Compile Remove="Engine\Text\ReclamationTests.cs" />
    <Compile Remove="Engine\Text\TallyTests.cs" />
    <Compile Remove="Engine\Text\ReleasedWriteTests.cs" />
    <Compile Remove="Engine\Text\MemoryTests.cs" />
    <Compile Remove="Engine\Text\LargeTextTests.cs" />
    <Compile Remove="Engine\Text\CountsUnderLoadTests.cs" />
    <Compile Remove="Engine\Replication\Text\ChildEntriesTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Moltaro.Lattice.TestSupport.Concurrency" />
    <Using Include="Moltaro.Lattice.TestSupport.Dependencies" />
    <Using Include="Moltaro.Lattice.TestSupport.Skips" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
