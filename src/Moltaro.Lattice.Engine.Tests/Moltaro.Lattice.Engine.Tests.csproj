<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The tests of the engine database read and write through the public interfaces as the scenario
         tests do; like them, they do not thread the test cancellation token through every call. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Moltaro.Lattice.Engine\Moltaro.Lattice.Engine.csproj" />
    <!-- The measurement program, for the tests of its reference fixture. -->
    <ProjectReference Include="..\Moltaro.Lattice.Measurements\Moltaro.Lattice.Measurements.csproj" />
    <ProjectReference Include="..\Moltaro.Lattice.TestSupport\Moltaro.Lattice.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests of the replication protocol of Epic 1, sprint S10, in the folder Replication, address
         internal types of the engine that its implementer creates under the names of the brief:
         Moltaro.Lattice.Replication.Protocol, FrameKindEnum, RefuseReasonEnum, HelloBody, FrameHeader and
         FrameCodec. Until they exist the folder is not compiled; its tests are skipped with the reason of
         the sprint as well. The implementer of S10 removes this item when the types are there. -->
    <Compile Remove="Replication\**" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Moltaro.Lattice.TestSupport.Concurrency" />
    <Using Include="Moltaro.Lattice.TestSupport.Dependencies" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
