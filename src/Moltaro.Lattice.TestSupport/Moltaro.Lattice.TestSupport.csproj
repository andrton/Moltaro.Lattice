<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Code that two or more test projects need. Never shipped, and it holds no tests. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Its types are internal, like everything outside the contract; the test projects that
         use them are its friends. -->
    <InternalsVisibleTo Include="Moltaro.Lattice.Tests" />
    <InternalsVisibleTo Include="Moltaro.Lattice.DependencyInjection.Tests" />
    <InternalsVisibleTo Include="Moltaro.Lattice.Engine.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The public contract, for the forms of an enumeration that tests of the contract and of the
         engine take alike (Enumeration.EnumerationForms). -->
    <ProjectReference Include="..\Moltaro.Lattice\Moltaro.Lattice.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The data the rule of equality without case is read from (Text.CaseRule), Unicode 16.0.0;
         its licence lies beside it. -->
    <EmbeddedResource Include="Text\UnicodeData.txt" LogicalName="Moltaro.Lattice.TestSupport.Text.UnicodeData.txt" />
  </ItemGroup>
</Project>
