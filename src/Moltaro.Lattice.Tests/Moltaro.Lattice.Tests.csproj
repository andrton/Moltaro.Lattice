<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Tests read as usage examples; they do not thread the test cancellation token through every call. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Moltaro.Lattice\Moltaro.Lattice.csproj" />
    <!-- The engine, whose LatticeDatabase opens the databases of the scenario tests. -->
    <ProjectReference Include="..\Moltaro.Lattice.Engine\Moltaro.Lattice.Engine.csproj" />
    <ProjectReference Include="..\Moltaro.Lattice.TestSupport\Moltaro.Lattice.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Moltaro.Lattice.Access" />
    <Using Include="Moltaro.Lattice.Schema" />
    <Using Include="Moltaro.Lattice.TestSupport.Concurrency" />
    <Using Include="Moltaro.Lattice.TestSupport.Dependencies" />
    <Using Include="Moltaro.Lattice.TestSupport.Replication" />
    <Using Include="Xunit" />
  </ItemGroup>
  <Import Project="../Moltaro.Lattice.Generators/UseGenerator.targets" />
</Project>
