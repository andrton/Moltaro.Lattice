<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The measurement program of the engine: the reference fixture and, in later sprints, the
         managed reference, the load profiles and the check of the machine. Started by hand; not a
         test project, and never shipped. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The engine, and through it the contract. -->
    <ProjectReference Include="..\Moltaro.Lattice.Engine\Moltaro.Lattice.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests of the reference fixture reach its internal class; see exception X3 in
         docs/work/exceptions.md. -->
    <InternalsVisibleTo Include="Moltaro.Lattice.Engine.Tests" />
  </ItemGroup>
</Project>
