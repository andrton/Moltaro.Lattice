<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The engine's types go into the namespaces Moltaro.Lattice.Storage,
         Moltaro.Lattice.Replication and Moltaro.Lattice.Engine, each a folder of this project,
         and LatticeDatabase, which moved here in S12, keeps its namespace Moltaro.Lattice at the
         root. A folder is a namespace, so the root is Moltaro.Lattice, not the name of the
         assembly. -->
    <RootNamespace>Moltaro.Lattice</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>The engine of Moltaro.Lattice: compact native storage, indexes, master-coordinated writes and replication to local read replicas.</Description>
    <PackageTags>database;in-memory;object-database;replication</PackageTags>
    <!-- The arena keeps its blocks in native memory from NativeMemory and reaches them through
         pointers: it writes a header in place and returns a reference or a span into a segment. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants Condition="'$(LatticeCollectionTimings)' == 'true'">$(DefineConstants);LATTICE_COLLECTION_TIMINGS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- The contract is the engine's one dependency: the engine references no package, and its
         hash tables are its own (the owner's decision of 18 November 2026). -->
    <ProjectReference Include="..\Moltaro.Lattice\Moltaro.Lattice.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The engine holds files adapted from projects under permissive licences, whose notices travel
         with copies: the notices of the repository go into the package, as in the core library. -->
    <None Include="$(MSBuildThisFileDirectory)..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests of engine mechanisms reach inside the engine; see exception X3 in docs/work/exceptions.md. -->
    <InternalsVisibleTo Include="Moltaro.Lattice.Engine.Tests" />
    <!-- So does the measurement program, which is never shipped: it uses internal types of the
         engine and reads its counters, under the same exception X3. -->
    <InternalsVisibleTo Include="Moltaro.Lattice.Measurements" />
    <!-- The scenario tests of the contract hold back the application of a child to check the
         consistency guarantees (EngineDatabase.SuspendApplying); nothing else of the engine. -->
    <InternalsVisibleTo Include="Moltaro.Lattice.Tests" />
  </ItemGroup>
</Project>
