<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The engine's types go into the namespaces Moltaro.Lattice.Storage,
         Moltaro.Lattice.Replication and Moltaro.Lattice.Engine, each a folder of this project,
         and LatticeDatabase, which moves here in S12, keeps its namespace Moltaro.Lattice. A
         folder is a namespace, so the root is Moltaro.Lattice, not the name of the assembly. -->
    <RootNamespace>Moltaro.Lattice</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>The engine of Moltaro.Lattice: compact native storage, indexes, master-coordinated writes and replication to local read replicas.</Description>
    <PackageTags>database;in-memory;object-database;replication</PackageTags>
    <!-- Internal types only so far, and no public entry point. Make the project packable in Epic 1,
         sprint S12, when the entry point moves here. -->
    <IsPackable>false</IsPackable>
    <!-- The arena keeps its blocks in native memory from NativeMemory and reaches them through
         pointers: it writes a header in place and returns a reference or a span into a segment. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The selected index structures, see docs/decisions/index-structures.md. The engine owns
         this package: no other shipped project references it. -->
    <PackageReference Include="Arc.Collections" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Moltaro.Lattice\Moltaro.Lattice.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests of engine mechanisms reach inside the engine; see exception X3 in docs/work/exceptions.md. -->
    <InternalsVisibleTo Include="Moltaro.Lattice.Engine.Tests" />
    <!-- So does the measurement program, which is never shipped: it uses internal types of the
         engine and reads its counters, under the same exception X3. -->
    <InternalsVisibleTo Include="Moltaro.Lattice.Measurements" />
    <!-- The scenario tests of the contract open the engine through its internal entry until S12; see exception X4 in docs/work/exceptions.md. -->
    <InternalsVisibleTo Include="Moltaro.Lattice.Tests" />
  </ItemGroup>
</Project>
