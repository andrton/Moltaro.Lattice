<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>A schema-driven in-memory object database for .NET, designed for compact storage, low-allocation access, master-coordinated writes, PostgreSQL persistence and local read replicas.</Description>
    <PackageTags>database;in-memory;object-database;replication</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- The core library holds data derived from the Unicode Character Database, whose licence asks
         that its notice travel with copies: the notices of the repository go into the package beside
         its README (Q47 of docs/work/open-questions.md). -->
    <None Include="$(MSBuildThisFileDirectory)..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The engine implements the contract and uses its internal members. -->
    <InternalsVisibleTo Include="Moltaro.Lattice.Engine" />
    <!-- The unshipped lookup tests and measurements bind probes with the same IndexValue as the engine. -->
    <InternalsVisibleTo Include="Moltaro.Lattice.Engine.Tests" />
    <InternalsVisibleTo Include="Moltaro.Lattice.Measurements" />
  </ItemGroup>
</Project>
