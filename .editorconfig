root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,props,targets,csproj,slnx,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning

# Copied from dotnet/aspnetcore and kept as published: not formatted or analyzed as code
# of this repository. See the README in that folder.
[src/Moltaro.Lattice.AspNet.Identity.Tests/Specification/*.cs]
generated_code = true
